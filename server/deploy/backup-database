#!/usr/bin/env bash
# Dumps the sikemux database, encrypts it to the age recipients in BACKUP_RECIPIENTS, uploads it
# to the R2 bucket and deletes backups older than 30 days. Run nightly by sikemux-backup.service.
# Citadel holds only the public key, so it can write backups but never read one back.
set -euo pipefail

recipients="${BACKUP_RECIPIENTS:-/etc/sikemux/backup-recipients.txt}"
: "${R2_BUCKET:?R2_BUCKET is not set}"
: "${R2_ACCESS_KEY_ID:?R2_ACCESS_KEY_ID is not set}"
: "${R2_SECRET_ACCESS_KEY:?R2_SECRET_ACCESS_KEY is not set}"
[ -n "${R2_ENDPOINT:-}" ] || : "${R2_ACCOUNT_ID:?R2_ACCOUNT_ID is not set}"

export RCLONE_CONFIG_R2_TYPE=s3
export RCLONE_CONFIG_R2_PROVIDER=Cloudflare
export RCLONE_CONFIG_R2_ENDPOINT="${R2_ENDPOINT:-https://$R2_ACCOUNT_ID.r2.cloudflarestorage.com}"
export RCLONE_CONFIG_R2_ACCESS_KEY_ID="$R2_ACCESS_KEY_ID"
export RCLONE_CONFIG_R2_SECRET_ACCESS_KEY="$R2_SECRET_ACCESS_KEY"
export RCLONE_CONFIG_R2_NO_CHECK_BUCKET=true
rclone() { command rclone --config "" --use-server-modtime "$@"; }

# Nightly runs start up to 20 minutes apart, so this deletes each backup on its 30th night and
# none is kept past 30 days.
prune_older_than=708h

grep -q '^age1' "$recipients" || { echo "no age public key in $recipients" >&2; exit 1; }

stamp="$(date -u +%Y%m%dT%H%M%SZ)"
object="sikemux/$(date -u +%Y/%m/%d)/sikemux-$stamp.dump.age"
work="$(mktemp -d)"
trap 'rm -rf "$work"' EXIT
file="$work/backup.dump.age"

echo "dumping the sikemux database"
pg_dump --format=custom --no-password --dbname="${PGDATABASE:-sikemux}" |
  age --encrypt --recipients-file "$recipients" >"$file"

size="$(wc -c <"$file" | tr -d ' ')"
md5="$(rclone md5sum "$file" | cut -d' ' -f1)"
echo "uploading $object ($size bytes)"
rclone copyto "$file" "r2:$R2_BUCKET/$object"

uploaded="$(rclone lsjson --hash --hash-type md5 "r2:$R2_BUCKET/$object")"
uploaded_size="$(printf '%s' "$uploaded" | grep -o '"Size":[0-9]*' | cut -d: -f2)"
uploaded_md5="$(printf '%s' "$uploaded" | grep -o '"md5":"[0-9a-f]*"' | cut -d'"' -f4)"
if [ "$uploaded_size" != "$size" ] || [ "$uploaded_md5" != "$md5" ]; then
  echo "the upload does not match: $uploaded_size bytes, md5 ${uploaded_md5:-none}; expected $size bytes, md5 $md5" >&2
  exit 1
fi
echo "uploaded and verified $object"

echo "deleting backups older than 30 days"
rclone delete --min-age "$prune_older_than" "r2:$R2_BUCKET/sikemux"
echo "kept $(rclone lsf --recursive --files-only "r2:$R2_BUCKET/sikemux" | wc -l | tr -d ' ') backups"

[Unit]
Description=Sikemux: encrypt a backup of the accounts database and send it to R2
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=oneshot
User=sikemux-backup
Group=sikemux-backup
EnvironmentFile=/etc/sikemux/backup.env
LoadCredential=recipients:/etc/sikemux/backup-recipients.txt
Environment=BACKUP_RECIPIENTS=%d/recipients
Environment=PGHOST=/var/run/postgresql PGUSER=sikemux_backup PGDATABASE=sikemux
Environment=RCLONE_CACHE_DIR=%C/sikemux-backup
CacheDirectory=sikemux-backup
ExecStart=/usr/local/lib/sikemux/backup-database
SyslogIdentifier=sikemux-backup
TimeoutStartSec=1h
Nice=10
IOSchedulingClass=idle
MemoryMax=512M
UMask=0077
NoNewPrivileges=yes
CapabilityBoundingSet=
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectProc=invisible
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service

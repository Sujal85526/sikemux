#!/usr/bin/env bash
# Checks the relay the way apps reach it: the relay itself, the HTTPS address Caddy serves, the
# plain-HTTP captive portal check, and the UDP port for QUIC address discovery. Exits non-zero on
# the first failure.
set -euo pipefail

HOST="${RELAY_HOST:-relay.sikemux.com}"
QUIC_PORT=7842

ok() { printf 'ok    %s\n' "$*"; }
bad() {
  printf 'FAIL  %s\n' "$*" >&2
  exit 1
}

health="$(curl -fsS --max-time 5 http://127.0.0.1:3340/healthz)" || bad "the relay does not answer on 127.0.0.1:3340"
ok "relay $health"

curl -fsS --max-time 5 -o /dev/null "https://$HOST/ping" || bad "https://$HOST/ping does not answer"
ok "https://$HOST/ping"

challenge="ts_$HOST"
response="$(curl -sS --max-time 5 -o /dev/null -D - -H "X-Iroh-Challenge: $challenge" "http://$HOST/generate_204" |
  tr -d '\r' | awk 'tolower($1) == "x-iroh-response:" { $1 = ""; sub(/^ /, ""); print }')"
[ "$response" = "response $challenge" ] || bad "http://$HOST/generate_204 does not answer the captive portal check"
ok "http://$HOST/generate_204"

ss -Hlun "sport = :$QUIC_PORT" | grep -q . || bad "nothing listens on udp/$QUIC_PORT"
ok "udp/$QUIC_PORT is listening"

if [ -r /etc/sikemux-relay/tls.crt ]; then
  openssl x509 -checkend $((14 * 86400)) -noout -in /etc/sikemux-relay/tls.crt >/dev/null ||
    bad "the relay's QUIC certificate expires within 14 days; is relay-certificate running?"
  ok "the QUIC certificate is good for at least 14 more days"
fi

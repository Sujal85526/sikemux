(sikemux_headers) {
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		-Server
	}
}

api.sikemux.com {
	import sikemux_headers
	header Referrer-Policy "no-referrer"
	encode zstd gzip
	request_body {
		max_size 1MB
	}
	reverse_proxy 127.0.0.1:4000
	log {
		output file /var/log/caddy/sikemux-api.log {
			roll_size 10MiB
			roll_keep 10
		}
		format json
	}
}

app.sikemux.com {
	import sikemux_headers
	header {
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "DENY"
	}
	root * /srv/sikemux/current/app
	encode zstd gzip
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"
	@pages not path /assets/*
	header @pages Cache-Control "no-cache"
	try_files {path} /index.html
	file_server
	log {
		output file /var/log/caddy/sikemux-app.log {
			roll_size 10MiB
			roll_keep 5
		}
		format json
	}
}

updates.sikemux.com {
	import sikemux_headers
	header Referrer-Policy "no-referrer"
	encode zstd gzip
	handle /manifest {
		rewrite * /updates/manifest
		reverse_proxy 127.0.0.1:4000
	}
	# Assets are stored as <sha256>.<type>.<subtype>, such as <sha256>.image.png, and served at
	# /assets/<sha256> with the media type their name carries.
	@asset {
		path_regexp ^/assets/[0-9a-f]{64}$
		file {
			root /srv/sikemux/updates
			try_files {path}.*
		}
	}
	route @asset {
		root * /srv/sikemux/updates
		rewrite {file_match.relative}
		@typed path_regexp type ^/assets/[0-9a-f]{64}\.([a-z]+)\.([a-z0-9.+-]+)$
		header @typed Content-Type {re.type.1}/{re.type.2}
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}
	respond 404
	log {
		output file /var/log/caddy/sikemux-updates.log {
			roll_size 10MiB
			roll_keep 10
		}
		format json
	}
}

{
  "openapi": "3.1.0",
  "info": { "title": "Sikemux API", "version": "1" },
  "servers": [{ "url": "https://api.sikemux.com" }],
  "paths": {
    "/v1/health": {
      "get": {
        "operationId": "getHealth",
        "summary": "Whether the API and its database are working",
        "security": [],
        "responses": {
          "200": {
            "description": "Everything works.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Health" }
              }
            }
          },
          "503": {
            "description": "The database cannot be reached.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Health" }
              }
            }
          },
          "default": {
            "description": "Something went wrong.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ApiError" }
              }
            }
          }
        }
      }
    },
    "/v1/devices/challenge": {
      "post": {
        "operationId": "createChallenge",
        "summary": "A one-time value for a device to sign before it registers",
        "responses": {
          "200": {
            "description": "The challenge, valid for two minutes.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Challenge" }
              }
            }
          },
          "default": {
            "description": "Something went wrong.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ApiError" }
              }
            }
          }
        }
      }
    },
    "/v1/devices": {
      "post": {
        "operationId": "registerDevice",
        "summary": "Add a device to your account, or update it",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/DeviceRegistration" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The device was already yours and is updated.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Device" }
              }
            }
          },
          "201": {
            "description": "The device was added.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Device" }
              }
            }
          },
          "default": {
            "description": "Something went wrong.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ApiError" }
              }
            }
          }
        }
      },
      "get": {
        "operationId": "listDevices",
        "summary": "Your devices",
        "parameters": [
          {
            "name": "role",
            "in": "query",
            "required": false,
            "schema": { "$ref": "#/components/schemas/DeviceRole" }
          }
        ],
        "responses": {
          "200": {
            "description": "Your devices, newest first.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/DeviceList" }
              }
            }
          },
          "default": {
            "description": "Something went wrong.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ApiError" }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ApiError": {
        "description": "The body of every response that is not a success.",
        "type": "object",
        "properties": {
          "error": { "$ref": "#/components/schemas/ErrorDetail" }
        },
        "required": ["error"],
        "additionalProperties": false
      },
      "Challenge": {
        "description": "A one-time value a device signs to prove it holds its key.",
        "type": "object",
        "properties": {
          "nonce": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "expiresAt": { "type": "string", "format": "date-time" }
        },
        "required": ["nonce", "expiresAt"],
        "additionalProperties": false
      },
      "Channel": {
        "description": "Which build a host runs. Dev, nightly and stable cores are separate hosts.",
        "type": "string",
        "enum": ["dev", "nightly", "stable"]
      },
      "Device": {
        "type": "object",
        "properties": {
          "key": { "$ref": "#/components/schemas/DeviceKey" },
          "role": { "$ref": "#/components/schemas/DeviceRole" },
          "name": { "type": "string" },
          "platform": { "$ref": "#/components/schemas/Platform" },
          "channel": { "$ref": "#/components/schemas/Channel" },
          "createdAt": { "type": "string", "format": "date-time" },
          "lastSeenAt": { "type": ["string", "null"], "format": "date-time" }
        },
        "required": [
          "key",
          "role",
          "name",
          "platform",
          "createdAt",
          "lastSeenAt"
        ],
        "additionalProperties": false
      },
      "DeviceKey": {
        "description": "A device's iroh public key: 32 bytes of Ed25519, in lowercase hex.",
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      },
      "DeviceList": {
        "type": "object",
        "properties": {
          "devices": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/Device" }
          }
        },
        "required": ["devices"],
        "additionalProperties": false
      },
      "DeviceRegistration": {
        "description": "Adds a device to the signed-in account, or updates it if it is already there. The signature is the device key's Ed25519 signature over the UTF-8 text `sikemux-register|<nonce>|<user id>|<key>`.",
        "type": "object",
        "properties": {
          "key": { "$ref": "#/components/schemas/DeviceKey" },
          "role": { "$ref": "#/components/schemas/DeviceRole" },
          "name": { "type": "string", "minLength": 1, "maxLength": 64 },
          "platform": { "$ref": "#/components/schemas/Platform" },
          "channel": { "$ref": "#/components/schemas/Channel" },
          "nonce": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "signature": { "type": "string", "pattern": "^[0-9a-f]{128}$" }
        },
        "required": ["key", "role", "name", "platform", "nonce", "signature"],
        "additionalProperties": false
      },
      "DeviceRole": {
        "description": "A host is a core people connect to, such as a Mac. A client connects to hosts, such as a phone.",
        "type": "string",
        "enum": ["host", "client"]
      },
      "ErrorCode": {
        "type": "string",
        "enum": [
          "bad_request",
          "unauthorized",
          "forbidden",
          "not_found",
          "conflict",
          "payload_too_large",
          "rate_limited",
          "internal",
          "unavailable"
        ]
      },
      "ErrorDetail": {
        "type": "object",
        "properties": {
          "code": { "$ref": "#/components/schemas/ErrorCode" },
          "message": {
            "description": "Written for whoever reads the logs. Apps show their own words for each code.",
            "type": "string"
          },
          "requestId": {
            "description": "The same as the response's x-request-id header, and how the server's logs find this request.",
            "type": "string"
          }
        },
        "required": ["code", "message", "requestId"],
        "additionalProperties": false
      },
      "Health": {
        "description": "Whether the API can serve requests, and which build is answering.",
        "type": "object",
        "properties": {
          "status": { "$ref": "#/components/schemas/HealthStatus" },
          "database": { "$ref": "#/components/schemas/HealthStatus" },
          "version": {
            "description": "The commit the running build was made from, or \"dev\".",
            "type": "string"
          }
        },
        "required": ["status", "database", "version"],
        "additionalProperties": false
      },
      "HealthStatus": { "type": "string", "enum": ["ok", "unavailable"] },
      "Platform": { "type": "string", "enum": ["macos", "ios", "android"] }
    },
    "securitySchemes": {
      "session": {
        "type": "http",
        "scheme": "bearer",
        "description": "A Clerk session token."
      }
    }
  },
  "security": [{ "session": [] }]
}

{
  "openapi": "3.1.0",
  "info": { "title": "Sikemux API", "version": "1" },
  "servers": [{ "url": "https://api.sikemux.com" }],
  "paths": {
    "/v1/health": {
      "get": {
        "operationId": "getHealth",
        "summary": "Whether the API and its database are working",
        "security": [],
        "responses": {
          "200": {
            "description": "Everything works.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Health" }
              }
            }
          },
          "503": {
            "description": "The database cannot be reached.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Health" }
              }
            }
          },
          "default": {
            "description": "Something went wrong.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ApiError" }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ApiError": {
        "description": "The body of every response that is not a success.",
        "type": "object",
        "properties": {
          "error": { "$ref": "#/components/schemas/ErrorDetail" }
        },
        "required": ["error"],
        "additionalProperties": false
      },
      "ErrorCode": {
        "type": "string",
        "enum": [
          "bad_request",
          "unauthorized",
          "forbidden",
          "not_found",
          "conflict",
          "payload_too_large",
          "rate_limited",
          "internal",
          "unavailable"
        ]
      },
      "ErrorDetail": {
        "type": "object",
        "properties": {
          "code": { "$ref": "#/components/schemas/ErrorCode" },
          "message": {
            "description": "Written for whoever reads the logs. Apps show their own words for each code.",
            "type": "string"
          },
          "requestId": {
            "description": "The same as the response's x-request-id header, and how the server's logs find this request.",
            "type": "string"
          }
        },
        "required": ["code", "message", "requestId"],
        "additionalProperties": false
      },
      "Health": {
        "description": "Whether the API can serve requests, and which build is answering.",
        "type": "object",
        "properties": {
          "status": { "$ref": "#/components/schemas/HealthStatus" },
          "database": { "$ref": "#/components/schemas/HealthStatus" },
          "version": {
            "description": "The commit the running build was made from, or \"dev\".",
            "type": "string"
          }
        },
        "required": ["status", "database", "version"],
        "additionalProperties": false
      },
      "HealthStatus": { "type": "string", "enum": ["ok", "unavailable"] }
    },
    "securitySchemes": {
      "session": {
        "type": "http",
        "scheme": "bearer",
        "description": "A Clerk session token."
      }
    }
  },
  "security": [{ "session": [] }]
}

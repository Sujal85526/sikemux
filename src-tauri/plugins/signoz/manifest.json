{
  "id": "sikemux.signoz",
  "name": "SigNoz",
  "version": "0.1.0",
  "sikemux": ">=0.4",
  "environment": ["SIGNOZ_URL", "SIGNOZ_API_KEY"],
  "tools": [
    {
      "name": "signoz_services",
      "method": "services",
      "description": "Every traced service with its calls, errors, error rate and p99 latency.",
      "properties": {
        "environment": {
          "type": "string",
          "description": "deployment.environment, e.g. production."
        },
        "minutes": {
          "type": "integer",
          "maximum": 10080,
          "description": "Default 30."
        },
        "start": {
          "type": "integer",
          "description": "Unix ms; with end, used instead of minutes."
        },
        "end": {
          "type": "integer",
          "description": "Unix ms."
        }
      },
      "required": []
    },
    {
      "name": "signoz_service_overview",
      "method": "serviceOverview",
      "description": "One service's request rate, error rate, p99 and p50, as totals and over time.",
      "properties": {
        "service": {
          "type": "string"
        },
        "environment": {
          "type": "string",
          "description": "deployment.environment, e.g. production."
        },
        "minutes": {
          "type": "integer",
          "maximum": 10080,
          "description": "Default 30."
        },
        "start": {
          "type": "integer",
          "description": "Unix ms; with end, used instead of minutes."
        },
        "end": {
          "type": "integer",
          "description": "Unix ms."
        },
        "filters": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "key": {
                "type": "string"
              },
              "op": {
                "type": "string",
                "enum": [
                  "equals",
                  "not-equals",
                  "contains",
                  "not-contains",
                  "exists",
                  "not-exists"
                ]
              },
              "value": {
                "type": [
                  "string",
                  "number",
                  "boolean"
                ]
              }
            },
            "required": [
              "key",
              "op"
            ],
            "additionalProperties": false
          },
          "description": "Leave value out for exists and not-exists."
        },
        "expression": {
          "type": "string",
          "description": "SigNoz filter syntax, e.g. status >= 500 AND path != '/health'."
        }
      },
      "required": [
        "service"
      ]
    },
    {
      "name": "signoz_endpoints",
      "method": "operations",
      "description": "One service's endpoints, busiest first, with rate, errors and latency.",
      "properties": {
        "service": {
          "type": "string"
        },
        "environment": {
          "type": "string",
          "description": "deployment.environment, e.g. production."
        },
        "minutes": {
          "type": "integer",
          "maximum": 10080,
          "description": "Default 30."
        },
        "start": {
          "type": "integer",
          "description": "Unix ms; with end, used instead of minutes."
        },
        "end": {
          "type": "integer",
          "description": "Unix ms."
        },
        "filters": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "key": {
                "type": "string"
              },
              "op": {
                "type": "string",
                "enum": [
                  "equals",
                  "not-equals",
                  "contains",
                  "not-contains",
                  "exists",
                  "not-exists"
                ]
              },
              "value": {
                "type": [
                  "string",
                  "number",
                  "boolean"
                ]
              }
            },
            "required": [
              "key",
              "op"
            ],
            "additionalProperties": false
          },
          "description": "Leave value out for exists and not-exists."
        },
        "expression": {
          "type": "string",
          "description": "SigNoz filter syntax, e.g. status >= 500 AND path != '/health'."
        }
      },
      "required": [
        "service"
      ]
    },
    {
      "name": "signoz_error_groups",
      "method": "errorGroups",
      "description": "One service's error logs grouped by message, with counts and first and last seen.",
      "properties": {
        "service": {
          "type": "string"
        },
        "environment": {
          "type": "string",
          "description": "deployment.environment, e.g. production."
        },
        "minutes": {
          "type": "integer",
          "maximum": 10080,
          "description": "Default 30."
        },
        "start": {
          "type": "integer",
          "description": "Unix ms; with end, used instead of minutes."
        },
        "end": {
          "type": "integer",
          "description": "Unix ms."
        },
        "filters": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "key": {
                "type": "string"
              },
              "op": {
                "type": "string",
                "enum": [
                  "equals",
                  "not-equals",
                  "contains",
                  "not-contains",
                  "exists",
                  "not-exists"
                ]
              },
              "value": {
                "type": [
                  "string",
                  "number",
                  "boolean"
                ]
              }
            },
            "required": [
              "key",
              "op"
            ],
            "additionalProperties": false
          },
          "description": "Leave value out for exists and not-exists."
        },
        "expression": {
          "type": "string",
          "description": "SigNoz filter syntax, e.g. status >= 500 AND path != '/health'."
        }
      },
      "required": [
        "service"
      ]
    },
    {
      "name": "signoz_search_logs",
      "method": "searchLogs",
      "description": "Search logs, newest first. What every returned line has in common is listed once in `shared`; each line keeps its id, timestamp, body and whatever differs. Bodies over 1000 characters are clipped; pass a line's id to read it whole. Page with nextOffset.",
      "properties": {
        "service": {
          "type": "string"
        },
        "text": {
          "type": "string",
          "description": "Text the body contains."
        },
        "severities": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Only these levels, e.g. [\"ERROR\", \"FATAL\"]; any case."
        },
        "traceId": {
          "type": "string",
          "description": "Only lines from this trace."
        },
        "id": {
          "type": "string",
          "description": "One line's id, to read that line whole."
        },
        "limit": {
          "type": "integer",
          "maximum": 200,
          "description": "Default 30."
        },
        "offset": {
          "type": "integer"
        },
        "environment": {
          "type": "string",
          "description": "deployment.environment, e.g. production."
        },
        "minutes": {
          "type": "integer",
          "maximum": 10080,
          "description": "Default 30."
        },
        "start": {
          "type": "integer",
          "description": "Unix ms; with end, used instead of minutes."
        },
        "end": {
          "type": "integer",
          "description": "Unix ms."
        },
        "filters": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "key": {
                "type": "string"
              },
              "op": {
                "type": "string",
                "enum": [
                  "equals",
                  "not-equals",
                  "contains",
                  "not-contains",
                  "exists",
                  "not-exists"
                ]
              },
              "value": {
                "type": [
                  "string",
                  "number",
                  "boolean"
                ]
              }
            },
            "required": [
              "key",
              "op"
            ],
            "additionalProperties": false
          },
          "description": "Leave value out for exists and not-exists."
        },
        "expression": {
          "type": "string",
          "description": "SigNoz filter syntax, e.g. status >= 500 AND path != '/health'."
        }
      },
      "required": []
    },
    {
      "name": "signoz_search_traces",
      "method": "searchTraces",
      "description": "Find traces by their root spans, slowest or most recent first.",
      "properties": {
        "service": {
          "type": "string"
        },
        "errorsOnly": {
          "type": "boolean",
          "description": "Only traces whose root span failed."
        },
        "minDurationMs": {
          "type": "number"
        },
        "order": {
          "type": "string",
          "enum": [
            "slowest",
            "recent"
          ]
        },
        "limit": {
          "type": "integer",
          "maximum": 200,
          "description": "Default 20."
        },
        "offset": {
          "type": "integer"
        },
        "environment": {
          "type": "string",
          "description": "deployment.environment, e.g. production."
        },
        "minutes": {
          "type": "integer",
          "maximum": 10080,
          "description": "Default 30."
        },
        "start": {
          "type": "integer",
          "description": "Unix ms; with end, used instead of minutes."
        },
        "end": {
          "type": "integer",
          "description": "Unix ms."
        },
        "filters": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "key": {
                "type": "string"
              },
              "op": {
                "type": "string",
                "enum": [
                  "equals",
                  "not-equals",
                  "contains",
                  "not-contains",
                  "exists",
                  "not-exists"
                ]
              },
              "value": {
                "type": [
                  "string",
                  "number",
                  "boolean"
                ]
              }
            },
            "required": [
              "key",
              "op"
            ],
            "additionalProperties": false
          },
          "description": "Leave value out for exists and not-exists."
        },
        "expression": {
          "type": "string",
          "description": "SigNoz filter syntax, e.g. status >= 500 AND path != '/health'."
        }
      },
      "required": []
    },
    {
      "name": "signoz_trace",
      "method": "trace",
      "description": "One trace as an outline in waterfall order: the root, every failing span and the spans with the most time of their own, each with its path from the root. `hidden` counts the spans left out below a span, and `service` appears only where it changes. Pass spanId to open one span and everything under it.",
      "properties": {
        "traceId": {
          "type": "string"
        },
        "minutes": {
          "type": "integer",
          "maximum": 10080,
          "description": "Look-back to find it in. Default 1440."
        },
        "spanId": {
          "type": "string"
        },
        "maxSpans": {
          "type": "integer",
          "maximum": 500,
          "description": "Default 40."
        }
      },
      "required": [
        "traceId"
      ]
    },
    {
      "name": "signoz_dashboards",
      "method": "dashboards",
      "description": "Saved dashboards: id, title, tags and panel count.",
      "properties": {},
      "required": []
    },
    {
      "name": "signoz_dashboard",
      "method": "dashboard",
      "description": "One dashboard's variables and panels, without their data. Read a drawable panel with signoz_dashboard_panel.",
      "properties": {
        "id": {
          "type": "string"
        }
      },
      "required": [
        "id"
      ]
    },
    {
      "name": "signoz_dashboard_panel",
      "method": "dashboardPanel",
      "description": "The data behind one dashboard panel over a window.",
      "properties": {
        "dashboardId": {
          "type": "string"
        },
        "panelId": {
          "type": "string"
        },
        "variables": {
          "type": "object",
          "additionalProperties": {
            "type": [
              "string",
              "number",
              "boolean"
            ]
          },
          "description": "Dashboard variable values by name, e.g. {\"environment\": \"production\"}; the rest keep the dashboard's choice."
        },
        "minutes": {
          "type": "integer",
          "maximum": 10080,
          "description": "Default 30."
        },
        "start": {
          "type": "integer",
          "description": "Unix ms; with end, used instead of minutes."
        },
        "end": {
          "type": "integer",
          "description": "Unix ms."
        }
      },
      "required": [
        "dashboardId",
        "panelId"
      ]
    },
    {
      "name": "signoz_field_keys",
      "method": "fieldKeys",
      "description": "Attribute names you can filter on, matching a search.",
      "properties": {
        "signal": {
          "type": "string",
          "enum": [
            "logs",
            "traces"
          ]
        },
        "search": {
          "type": "string"
        }
      },
      "required": []
    },
    {
      "name": "signoz_field_values",
      "method": "fieldValues",
      "description": "Values one attribute takes, matching a search.",
      "properties": {
        "signal": {
          "type": "string",
          "enum": [
            "logs",
            "traces"
          ]
        },
        "name": {
          "type": "string"
        },
        "search": {
          "type": "string"
        }
      },
      "required": [
        "name"
      ]
    }
  ]
}

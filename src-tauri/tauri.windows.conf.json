{
  "$schema": "https://schema.tauri.app/config/2",
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Sikemux",
        "width": 1340,
        "height": 880,
        "minWidth": 860,
        "minHeight": 540,
        "decorations": true,
        "transparent": false
      }
    ]
  },
  "bundle": {
    "targets": ["nsis"],
    "createUpdaterArtifacts": false,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}

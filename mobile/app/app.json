{
  "expo": {
    "name": "Sikemux",
    "slug": "sikemux",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "sikemux",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.nodelike.sikemux.mobile",
      "supportsTablet": true,
      "infoPlist": {
        "NSLocalNetworkUsageDescription": "Sikemux finds the Macs on your network that you can pair with.",
        "NSBonjourServices": ["_sikemux._udp"]
      }
    },
    "android": {
      "package": "com.nodelike.sikemux.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#0B0B0F",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      }
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "./plugins/link-system-configuration",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B0B0F",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}

{
  "name": "sikemux-mobile",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "native:ios": "pnpm --filter @sikemux/native ubrn:ios",
    "native:android": "pnpm --filter @sikemux/native ubrn:android",
    "native:ios:release": "pnpm --filter @sikemux/native ubrn:ios:release",
    "native:android:release": "pnpm --filter @sikemux/native ubrn:android:release",
    "ios": "pnpm --filter sikemux-app ios",
    "android": "pnpm --filter sikemux-app android",
    "ios:release": "pnpm --filter sikemux-app ios:release",
    "android:release": "pnpm --filter sikemux-app android:release",
    "start": "pnpm --filter sikemux-app start",
    "typecheck": "pnpm -r typecheck"
  }
}

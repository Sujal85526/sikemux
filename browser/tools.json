    "file": "SIKEMUX_GUIDE.md",
    "name": "guide",
    "row": {"verb": "read", "kind": "read", "icon": "info", "target": ["the guide: {topic}", "the guide"]},
    "description": "Read before your first task launch or browser click. Pass a topic for one area in depth.",
    "comment": "Served by the sidecar from its own bundle, so it has no harness method."
  },

            "back",
            "forward",
            "reload"
          ]
        },
        "hard": {
          "type": "boolean"
        },
        "waitFor": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "text": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            },
